<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - NodeContactos</title>
  <style>
    :root {
      color-scheme: dark;
      --bg: #0f172a;
      --card: #1e293b;
      --text: #f8fafc;
      --muted: #94a3b8;
      --border: #334155;
      --primary: #6366f1;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      min-height: 100vh;
      padding: 2rem;
      background: radial-gradient(circle at top right, #1e1b4b, var(--bg) 60%);
      color: var(--text);
      font-family: 'Segoe UI', Arial, sans-serif;
    }
    .container { max-width: 1050px; margin: 0 auto; }
    header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 1rem;
      margin-bottom: 2rem;
    }
    h1 { margin: 0; }
    .header-actions, nav, .actions { display: flex; flex-wrap: wrap; gap: 0.75rem; }
    .header-actions { align-items: flex-end; flex-direction: column; justify-content: center; }
    .user-chip {
      display: flex;
      align-items: center;
      gap: 0.7rem;
      min-width: 0;
      padding: 0.35rem 0.9rem 0.35rem 0.4rem;
      border: 1px solid rgba(148, 163, 184, 0.2);
      border-radius: 999px;
      background: rgba(30, 41, 59, 0.72);
    }
    .user-avatar {
      display: grid;
      flex: 0 0 2.4rem;
      width: 2.4rem;
      height: 2.4rem;
      place-items: center;
      border: 2px solid rgba(255, 255, 255, 0.16);
      border-radius: 50%;
      background: linear-gradient(135deg, #818cf8, #c084fc);
      color: white;
      font-size: 0.9rem;
      font-weight: 800;
      box-shadow: 0 3px 12px rgba(99, 102, 241, 0.3);
    }
    .user-copy { min-width: 0; }
    .user-greeting {
      display: block;
      margin-bottom: 0.1rem;
      color: var(--muted);
      font-size: 0.72rem;
    }
    .user-name {
      display: block;
      max-width: 15rem;
      overflow: hidden;
      color: var(--text);
      font-size: 0.9rem;
      font-weight: 700;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    a {
      display: inline-block;
      padding: 0.7rem 1rem;
      border-radius: 0.5rem;
      background: var(--primary);
      color: white;
      font-weight: 600;
      text-decoration: none;
    }
    a.secondary { background: transparent; border: 1px solid var(--border); }
    .intro { margin-bottom: 1.5rem; color: var(--muted); }
    .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(245px, 1fr)); gap: 1rem; }
    .card {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      padding: 1.1rem 1.25rem;
      border: 1px solid var(--border);
      border-radius: 0.75rem;
      background: var(--card);
    }
    .contact-heading { display: flex; align-items: center; gap: 0.7rem; margin-bottom: 0.4rem; }
    .contact-avatar {
      display: grid;
      flex: 0 0 2.2rem;
      width: 2.2rem;
      height: 2.2rem;
      place-items: center;
      border: 1px solid rgba(255, 255, 255, 0.16);
      border-radius: 50%;
      background: linear-gradient(135deg, #818cf8, #c084fc);
      color: white;
      font-size: 0.85rem;
      font-weight: 800;
    }
    .card h2 { margin: 0; font-size: 1.1rem; }
    .card p { margin: 0; color: var(--muted); font-size: 0.9rem; }
    .card .actions { flex: 0 0 auto; }
    .contact-email { overflow-wrap: anywhere; }
    .card a { white-space: nowrap; }
    .empty { padding: 2rem; border: 1px solid var(--border); border-radius: 0.75rem; color: var(--muted); }
    @media (max-width: 600px) {
      body { padding: 1rem; }
      header { align-items: flex-start; flex-direction: column; }
      .header-actions { align-items: flex-start; }
      .user-name { max-width: 11rem; }
      .card { align-items: flex-start; flex-direction: column; }
    }
  </style>
</head>
<body>
  <main class="container">
    <header>
      <h1>📇 Agenda de contactos</h1>
      <div class="header-actions">
        <% if (user) { %>
          <div class="user-chip">
            <span class="user-avatar" aria-hidden="true"><%= user.nombre.trim().charAt(0).toUpperCase() %></span>
            <span class="user-copy">
              <span class="user-greeting">Sesión iniciada</span>
              <span class="user-name"><%= user.nombre %></span>
            </span>
          </div>
          <nav aria-label="Acciones de usuario">
            <a href="/contactos/nuevo">+ Nuevo contacto</a>
            <a class="secondary" href="/auth/logout">Cerrar sesión</a>
          </nav>
        <% } else { %>
          <nav aria-label="Acceso a la cuenta">
            <a class="secondary" href="/auth/login">Iniciar sesión</a>
            <a href="/auth/register">Crear una cuenta</a>
          </nav>
        <% } %>
      </div>
    </header>

    <p class="intro">Consulta la agenda. Inicia sesión para ver el detalle y gestionar los contactos.</p>

    <% if (contactos.length > 0) { %>
      <section class="grid" aria-label="Contactos">
        <% contactos.forEach(contacto => { %>
          <article class="card">
            <div>
              <div class="contact-heading">
                <span class="contact-avatar" aria-hidden="true"><%= contacto.nombre.trim().charAt(0).toUpperCase() %></span>
                <h2><%= contacto.nombre %></h2>
              </div>
              <p class="contact-email"><%= contacto.email || 'Sin correo electrónico' %></p>
              <p class="contact-location"><%= contacto.provincia %>, <%= contacto.pais %></p>
            </div>
            <div class="actions">
              <a href="/contactos/<%= contacto.id %>">Ver más</a>
            </div>
          </article>
        <% }); %>
      </section>
    <% } else { %>
      <div class="empty">Todavía no hay contactos en la agenda.</div>
    <% } %>
  </main>
</body>
</html>
